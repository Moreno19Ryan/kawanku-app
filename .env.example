# Salin file ini menjadi .env.local lalu isi nilainya dari
# Supabase Dashboard → Project Settings → API.
# Hanya variabel NEXT_PUBLIC_* yang boleh diisi di file contoh ini. JANGAN
# taruh nilai secret apa pun di repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_..., Project Settings → API Keys). Khusus server:
# membuat akun admin & mengatur ulang kata sandi dari Pengaturan → Admin.
# Isi hanya di .env.local (lokal) dan Vercel Environment Variables; biarkan
# KOSONG di sini. Tanpa ini, fitur tersebut nonaktif.
SUPABASE_SECRET_KEY=
